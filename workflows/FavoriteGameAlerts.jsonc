{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Favorite Game Alerts",
  "description": "Sends daily email alerts to users about upcoming games for their favorite teams",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "favorite_game_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_alerts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendFavoriteGameAlerts"
          },
          "then": "end",
          "x-base44": {
            "title": "Send favorite game alerts",
            "description": "Email users about upcoming favorite team games"
          }
        }
      }
    ]
  }
}